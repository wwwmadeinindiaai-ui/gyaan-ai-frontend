# ==============================================================================
# GYAAN AI - Environment Variables Configuration
# ==============================================================================
#
# Copy this file to .env.local for local development
# For production, set these in your hosting platform (Vercel, etc.)
#
# Required variables are marked with [REQUIRED]
# Optional variables are marked with [OPTIONAL]
#

# ------------------------------------------------------------------------------
# Firebase Configuration (Client-side)
# ------------------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > General
# Used for client-side authentication and Firestore access

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Server-side) [REQUIRED]
# ------------------------------------------------------------------------------
# Get service account JSON from Firebase Console > Project Settings > Service Accounts
# Either set individual fields OR use FIREBASE_SERVICE_ACCOUNT

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# Alternative: Full service account JSON (recommended for production)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ------------------------------------------------------------------------------
# NextAuth.js [REQUIRED]
# ------------------------------------------------------------------------------
# Generate secret with: openssl rand -base64 32

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl_rand_base64_32

# ------------------------------------------------------------------------------
# OAuth Providers [OPTIONAL]
# ------------------------------------------------------------------------------
# Enable Google and GitHub login
# Get credentials from respective developer consoles

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ------------------------------------------------------------------------------
# External API Connectors [OPTIONAL]
# ------------------------------------------------------------------------------
# These power the search connectors in /lib/connectors.ts
# Missing keys will cause those connectors to be skipped (with warnings)

# NewsAPI - https://newsapi.org/
# Used for fetching news articles
NEWSAPI_KEY=your_newsapi_key

# Google Custom Search API - https://developers.google.com/custom-search
# Used for web search results
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_custom_search_engine_id

# Unsplash API - https://unsplash.com/developers
# Used for image search
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# YouTube Data API v3 - https://console.cloud.google.com/
# Used for video search (enable YouTube Data API v3 in Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Gemini API - https://makersuite.google.com/
# Used for AI-powered synthesis
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# Application Configuration [OPTIONAL]
# ------------------------------------------------------------------------------

# App identifier for Firestore paths
NEXT_PUBLIC_APP_ID=gyaan-ai

# API base URL (for client-side API calls)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# Development & Debugging [OPTIONAL]
# ------------------------------------------------------------------------------

# Enable verbose logging
DEBUG=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Production Settings [OPTIONAL]
# ------------------------------------------------------------------------------

# Sentry DSN for error tracking
# SENTRY_DSN=your_sentry_dsn

# Rate limiting
# RATE_LIMIT_REQUESTS_PER_MINUTE=60

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
